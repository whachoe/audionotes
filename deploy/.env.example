# Copy this file to deploy/.env and fill in real values.
# `docker compose` (run from this deploy/ directory) reads .env automatically;
# the app and caddy services also load it explicitly via env_file.

# --- Required ---

# Single static bearer token protecting every backend route except /health.
API_TOKEN=changeme

# Public domain name Caddy will request a Let's Encrypt certificate for,
# and reverse-proxy to the app service.
DOMAIN=notes.example.com

# --- faster-whisper (transcription) ---
# See https://github.com/SYSTRAN/faster-whisper for valid model sizes and
# device/compute_type combinations (e.g. cpu/int8, cuda/float16).
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Ollama (title summarization) ---
# OLLAMA_BASE_URL is not listed here: docker-compose.yml points the app at
# the `ollama` service directly (http://ollama:11434).
OLLAMA_MODEL=llama3.2:3b

# --- Google Calendar linking (Phase 2, optional) ---
# Leave all three blank to keep the feature disabled. Create an OAuth 2.0
# "Web application" client in Google Cloud Console (with the Calendar API
# enabled) and register GOOGLE_REDIRECT_URI exactly as its redirect URI -
# it must be this server's public URL + /api/google/auth/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://notes.example.com/api/google/auth/callback
# GOOGLE_CALENDAR_ID=primary

# --- Optional ---

# How often (seconds) the background worker polls for queued notes.
# POLL_INTERVAL_SECONDS=2.0

# Root directory for persisted data (sqlite db, audio, markdown notes) as
# seen *inside* the app container. docker-compose.yml already sets this to
# /data and bind-mounts ./data there, so you normally don't need to change it.
# DATA_DIR=/data
