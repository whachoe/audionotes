[Unit]
Description=cjpa's Notes backend (FastAPI/uvicorn)
# Soft ordering only (not Requires=) - date_recognition already treats a
# not-yet-up Duckling as "no date found", so the backend must still start
# fine even if duckling.service is slow to come up or down entirely.
After=network.target duckling.service

[Service]
Type=simple
# Adjust to wherever you check out/copy the repo on the server.
WorkingDirectory=/opt/audionotes
# --app-dir src makes `backend` importable as a top-level package, matching
# pyproject.toml's pythonpath used for local dev/tests.
ExecStart=/opt/audionotes/.venv/bin/uvicorn backend.main:app --app-dir src --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

# Run as a dedicated, unprivileged user rather than root.
User=audionotes
Group=audionotes

Environment=PYTHONUNBUFFERED=1
Environment=DATA_DIR=/var/lib/audionotes
Environment=WHISPER_MODEL_SIZE=small
Environment=WHISPER_DEVICE=cpu
Environment=WHISPER_COMPUTE_TYPE=int8
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=qwen2.5:14b

# Duckling (Phase 4), run via deploy/systemd/duckling.service.
Environment=DUCKLING_BASE_URL=http://127.0.0.1:8000

# Google sign-in + Calendar linking (Phase 3) - required now: there is no
# other way to log in. Needs an OAuth 2.0 "Web application" client (Google
# Cloud Console, Calendar API enabled). GOOGLE_REDIRECT_URI must exactly
# match that client's registered redirect URI. ALLOWED_GOOGLE_EMAILS is a
# comma-separated allow-list - only these accounts can sign in.
Environment=GOOGLE_CLIENT_ID=
Environment=GOOGLE_CLIENT_SECRET=
Environment=GOOGLE_REDIRECT_URI=https://notes.copywaste.org/api/google/auth/callback
Environment=GOOGLE_CALENDAR_ID=primary
Environment=ALLOWED_GOOGLE_EMAILS=whachoe@gmail.com,jo.giraerts@gmail.com,cuppens.katrien@gmail.com

[Install]
WantedBy=multi-user.target
