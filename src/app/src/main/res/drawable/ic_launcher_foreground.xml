<?xml version="1.0" encoding="utf-8"?>
<!-- Copywaste Notes launcher glyph: a "C"+"N" monogram in the Copywaste brand
     colors (navy C, off-white N), scaled to the adaptive-icon foreground safe
     zone. Pairs with the solid red ic_launcher_background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M 50.29,45.4 A 15,15 0 1 0 50.29,62.6"
        android:strokeColor="@color/copywaste_navy"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 62,78 L 62,30 L 86,78 L 86,30"
        android:strokeColor="@color/copywaste_off_white"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
