<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup/transfer rules for Android 12+ (android:dataExtractionRules).
  Same exclusion as backup_rules.xml - see the comment there for why.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cjpa_notes_secure_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cjpa_notes_secure_settings.xml" />
    </device-transfer>
</data-extraction-rules>
